# Copy this file to .env and add your own credentials locally.
# Never commit .env or put API keys in screenshots, issues, or documentation.

# AI provider: groq, openai, or gemini (Gemini requires google-generativeai).
AI_PROVIDER=groq
AI_ENABLED=false

# Groq (used when AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database; SQLite is suitable for local development.
DATABASE_URL=sqlite:///./leads.db

# Comma-separated browser origins if frontend and backend are split.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
